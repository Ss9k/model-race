# Cloud LLM provider: "gemini" or "groq"
CLOUD_PROVIDER=gemini

# API Keys (store real keys only in .env; never commit .env)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b

# Optional paid list price overrides (USD per 1M tokens)
# Leave blank to use built-in documented rates when available
CLOUD_INPUT_PRICE_PER_1M=
CLOUD_OUTPUT_PRICE_PER_1M=

# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Request timing & pacing
REQUEST_TIMEOUT=30
CLOUD_REQUEST_DELAY=0.5

# Dataset configuration
CSV_PATH=data/reviews.csv
TEXT_COLUMN=review
LABEL_COLUMN=sentiment